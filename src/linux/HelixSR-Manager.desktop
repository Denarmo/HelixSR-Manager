[Desktop Entry]
Version=1.0
Type=Application
Name=HelixSR Manager
Comment=DLSS Model E Neural Upscaler & Game Manager for Linux & SteamOS
Exec=bash -c 'd="${1#file://}"; if [ -n "$d" ] && [ ! -e "$d" ]; then d="$(python3 -c "import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))" "$d" 2>/dev/null || python -c "import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))" "$d" 2>/dev/null || echo "$d")"; fi; if [ -n "$d" ] && [ -e "$d" ]; then if [ -d "$d" ]; then cd "$d"; else cd "$(dirname "$d")"; fi; fi; if [ ! -f "./HelixSR-Manager.sh" ] && [ ! -f "./helixsr_swapper_linux.py" ]; then for c in "$PWD" "$(cat "${XDG_DATA_HOME:-$HOME/.local/share}/HelixSR/app_dir.txt" 2>/dev/null)" "$HOME/HelixSR-Manager" "$HOME/Downloads/helixsr-manager-linux" "$HOME/Downloads/HelixSR-Manager" "$HOME/Downloads" "$HOME/Desktop/helixsr-manager-linux" "$HOME/Desktop/HelixSR-Manager" "$HOME/Desktop"; do if [ -n "$c" ] && [ -f "$c/HelixSR-Manager.sh" ]; then cd "$c"; break; fi; done; fi; if [ ! -f "./HelixSR-Manager.sh" ] && [ ! -f "./helixsr_swapper_linux.py" ]; then found="$(find "$HOME/Downloads" "$HOME/Desktop" "$HOME" -maxdepth 3 -name "helixsr_swapper_linux.py" -print -quit 2>/dev/null || true)"; if [ -n "$found" ]; then cd "$(dirname "$found")"; fi; fi; chmod +x ./HelixSR-Manager.sh ./helixsr_swapper_linux.py 2>/dev/null || true; exec bash ./HelixSR-Manager.sh' -- %k
Icon=utilities-terminal
Terminal=false
Categories=Game;Utility;
StartupNotify=false
