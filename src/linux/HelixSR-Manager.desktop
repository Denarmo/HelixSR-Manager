[Desktop Entry]
Version=1.0
Type=Application
Name=HelixSR Manager
Comment=DLSS Model E Neural Upscaler & Game Manager for Linux & SteamOS
Exec=bash -c 'IFS=; d=${1#file://}; d=${d//%%20/ }; if [[ -n $d && -e $d ]]; then if [[ -d $d ]]; then cd -- $d; elif [[ $d == */* ]]; then cd -- ${d%/*}; fi; fi; if [[ ! -f ./HelixSR-Manager.sh && ! -f ./helixsr_swapper_linux.py ]]; then s=$(cat ${XDG_DATA_HOME:-$HOME/.local/share}/HelixSR/app_dir.txt 2>/dev/null || true); for c in $s $HOME/HelixSR-Manager $HOME/Downloads/helixsr-manager-linux $HOME/Downloads/HelixSR-Manager $HOME/Downloads $HOME/Desktop/helixsr-manager-linux $HOME/Desktop/HelixSR-Manager $HOME/Desktop; do if [[ -n $c && -f $c/HelixSR-Manager.sh ]]; then cd -- $c; break; fi; done; fi; if [[ ! -f ./HelixSR-Manager.sh && ! -f ./helixsr_swapper_linux.py ]]; then f=$(find $HOME/Downloads $HOME/Desktop $HOME -maxdepth 3 -name helixsr_swapper_linux.py -print -quit 2>/dev/null || true); if [[ -n $f ]]; then cd -- ${f%/*}; fi; fi; chmod +x ./HelixSR-Manager.sh ./helixsr_swapper_linux.py 2>/dev/null || true; exec bash ./HelixSR-Manager.sh' -- %k
Icon=applications-games
Terminal=false
Categories=Game;Utility;
StartupNotify=false
